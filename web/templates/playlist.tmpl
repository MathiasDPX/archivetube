{{define "title"}}{{.Playlist.Name}} - ArchiveTube{{end}}
{{define "content"}}
<div class="page-shell">
    <div class="playlist-detail-header">
        <div class="playlist-detail-title-row">
            <h1 class="page-heading playlist-detail-name" id="playlist-name" data-id="{{.Playlist.ID}}">{{.Playlist.Name}}</h1>
            {{if or (not authEnabled) (loggedIn)}}
            <div class="dropdown">
                <button type="button" class="threedots-btn dropdown-toggle" aria-label="Options">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/></svg>
                </button>
                <div class="dropdown-menu dropdown-menu-transparent">
                    <button type="button" class="dropdown-item" id="rename-btn">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 000-1.41l-2.34-2.34a1 1 0 00-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                        Rename
                    </button>
                    <button type="button" class="dropdown-item dropdown-item-danger" id="delete-btn">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                        Delete playlist
                    </button>
                </div>
            </div>
            {{end}}
        </div>
        <span class="playlist-detail-meta">{{.Total}} video{{if ne .Total 1}}s{{end}} · Updated {{fmtDate .Playlist.UpdatedAt}}</span>
    </div>

    <div id="playlist-videos">
        {{if .Videos}}
        <ol class="playlist-video-list">
            {{range $i, $v := .Videos}}
            <li class="playlist-video-row" data-video-id="{{$v.YoutubeVideoID}}">
                <span class="playlist-video-index">{{add $i 1}}</span>
                <a href="/videos/{{$v.YoutubeVideoID}}" class="playlist-video-thumb">
                    {{if $v.ThumbnailRelPath}}
                    <img src="/data/{{webPath $v.ThumbnailRelPath}}" alt="" loading="lazy">
                    {{end}}
                    <span class="badge-duration">{{fmtDuration $v.DurationSeconds}}</span>
                </a>
                <div class="playlist-video-info">
                    <a href="/videos/{{$v.YoutubeVideoID}}" class="playlist-video-title">{{$v.Title}}</a>
                    <a href="/creators/{{$v.ChannelYoutubeID}}" class="playlist-video-channel">{{$v.ChannelName}}</a>
                </div>
            </li>
            {{end}}
        </ol>
        {{else}}
        <div class="empty"><p>No videos in this playlist yet.</p></div>
        {{end}}
    </div>
</div>
{{end}}
{{define "scripts"}}
<script>
(function () {
    var pid = document.getElementById("playlist-name").dataset.id;

    document.addEventListener('click', function (e) {
        var toggle = e.target.closest && e.target.closest('.dropdown-toggle');
        if (toggle) {
            e.stopPropagation();
            var dd = toggle.closest('.dropdown');
            var wasOpen = dd.classList.contains('open');
            document.querySelectorAll('.dropdown.open').forEach(function (d) { d.classList.remove('open'); });
            if (!wasOpen) dd.classList.add('open');
            return;
        }
        document.querySelectorAll('.dropdown.open').forEach(function (d) { d.classList.remove('open'); });
    });

    var renameBtn = document.getElementById("rename-btn");
    if (renameBtn) {
        renameBtn.addEventListener("click", function () {
            var current = document.getElementById("playlist-name").textContent.trim();
            var name = prompt("New playlist name:", current);
            if (!name || name === current) return;
            fetch("/api/playlists/" + pid + "/rename", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ name: name })
            })
                .then(function (r) {
                    if (!r.ok) return r.json().then(function (d) { throw new Error(d.error || "failed"); });
                    return r.json();
                })
                .then(function () {
                    document.getElementById("playlist-name").textContent = name;
                    document.title = name + " - ArchiveTube";
                })
                .catch(function (err) { alert(err.message); });
        });
    }

    var deleteBtn = document.getElementById("delete-btn");
    if (deleteBtn) {
        deleteBtn.addEventListener("click", function () {
            if (!confirm("Delete this playlist? Videos will not be deleted.")) return;
            fetch("/api/playlists/" + pid + "/delete", { method: "POST" })
                .then(function (r) {
                    if (!r.ok) throw new Error("failed");
                    window.location.href = "/playlists";
                })
                .catch(function () { alert("Failed to delete playlist"); });
        });
    }

})();
</script>
{{end}}
