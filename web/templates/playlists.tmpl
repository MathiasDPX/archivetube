{{define "title"}}Playlists - ArchiveTube{{end}}
{{define "content"}}
<div class="page-shell">
    <div class="playlists-header">
        <h1 class="page-heading">Playlists</h1>
    </div>

    {{if .Playlists}}
    <div class="video-grid">
        {{range .Playlists}}
        <div class="video-card">
            <a href="/playlists/{{.ID}}" class="thumb-link">
                <div class="thumb">
                    {{if .ThumbnailRelPath}}
                    <img src="/data/{{webPath .ThumbnailRelPath}}" alt="" loading="lazy">
                    {{else}}
                    <div class="playlist-thumb-empty">
                        <svg viewBox="0 0 24 24" width="48" height="48" fill="currentColor"><path d="M22 7H2v1h20V7zm-9 5H2v1h11v-1zM2 17h11v-1H2v1zm13-1v6l5-3-5-3z"/></svg>
                    </div>
                    {{end}}
                    <span class="badge-playlist">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M22 7H2v1h20V7zm-9 5H2v1h11v-1zM2 17h11v-1H2v1zm13-1v6l5-3-5-3z"/></svg>
                        {{.VideoCount}} video{{if ne .VideoCount 1}}s{{end}}
                    </span>
                </div>
            </a>
            <div class="card-body">
                <a href="/playlists/{{.ID}}" class="card-title">{{.Name}}</a>
                <span class="card-meta">Updated {{fmtDate .UpdatedAt}}</span>
            </div>
        </div>
        {{end}}
    </div>
    {{else}}
    <div class="empty">
        <p>No playlists yet.</p>
        {{if or (not authEnabled) (loggedIn)}}
        <a class="link-subtle" href="/archive">Archive it →</a>
        {{end}}
    </div>
    {{end}}
</div>
{{end}}
