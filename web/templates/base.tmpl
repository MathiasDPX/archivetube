{{define "base"}}<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{block "title" .}}ArchiveTube{{end}}</title>
    <link rel="icon" type="image/png" href="/static/favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:ital,wght@0,100..700;1,100..700&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/static/css/main.css">

    <meta property="og:site_name" content="ArchiveTube" />
    <meta property="og:type" content="video.other" />
    <meta property="og:url" content="{{ currentURL }}">

    {{ block "opengraph" .}}
    <meta property="og:image" content="/static/banner.png">
    <meta property="og:description" content="Self-hosted YouTube archiving application" />
    <meta property="og:title" content="ArchiveTube">
    <meta name="twitter:card" content="summary_large_image">
    {{ end }}
</head>
<body>
    <header class="topbar">
        <div class="topbar-inner">
            <a href="/" class="logo"><img src="/static/favicon.svg"> <span class="logo-text">ArchiveTube</span></a>
            <a href="/" class="logo-mobile"><img src="/static/favicon.svg"> <span class="logo-text">ArchiveTube</span></a>
            <form class="topbar-search" method="get" action="/">
                <div class="search-box">
                    <input type="text" name="q" placeholder="Search" class="search-input">
                    <button type="submit" class="search-btn" aria-label="Search">
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                    </button>
                </div>
            </form>
            <nav class="nav-links">
                {{if or (not authEnabled) (loggedIn)}}
                <a href="/archive" class="nav-link-pill">Archive</a>
                {{else}}
                <a href="/login" class="nav-link-pill">Login</a>
                {{end}}
                <details class="nav-dropdown">
                    <summary class="nav-dropdown-toggle" aria-label="Open navigation menu" aria-haspopup="menu">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <path d="M4 7h16M4 12h16M4 17h16" />
                        </svg>
                    </summary>
                    <div class="nav-dropdown-menu" role="menu">
                        <a href="/creators" class="nav-dropdown-item" role="menuitem">Creators</a>
                        <a href="/playlists" class="nav-dropdown-item" role="menuitem">Playlist</a>
                    </div>
                </details> 
            </nav>
        </div>
    </header>
    <main>
        {{block "content" .}}{{end}}
    </main>
    <footer>{{if eq gitSHA "dev"}}dev build{{else}}Build <a href="https://github.com/MathiasDPX/archivetube/commit/{{ gitSHA }}" target="_blank">{{ slice gitSHA 0 8 }}</a>{{end}}</footer>
    <script src="/static/js/ui.js"></script>
    {{block "scripts" .}}{{end}}
</body>
</html>{{end}}
